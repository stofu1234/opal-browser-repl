{
  "manifest_version": 2,
  "name": "Opal DevTools",
  "version": "1.0.0",
  "description": "Ruby/Opal REPL for Firefox DevTools - Execute Ruby code directly in your browser",
  "devtools_page": "devtools.html",
  "permissions": [
    "<all_urls>",
    "storage"
  ],
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/opal-16.png",
      "48": "icons/opal-48.png",
      "128": "icons/opal-128.png"
    }
  },
  "icons": {
    "16": "icons/opal-16.png",
    "48": "icons/opal-48.png",
    "128": "icons/opal-128.png"
  },
  "web_accessible_resources": [
    "lib/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "opal-devtools@example.com",
      "strict_min_version": "78.0"
    }
  }
}
