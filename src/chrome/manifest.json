{
  "manifest_version": 3,
  "name": "Opal DevTools",
  "version": "1.0.0",
  "description": "Ruby/Opal REPL for Chrome DevTools - Execute Ruby code directly in your browser",
  "devtools_page": "devtools.html",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/opal-16.png",
    "48": "icons/opal-48.png",
    "128": "icons/opal-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
