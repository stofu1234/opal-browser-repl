{
  "manifest_version": 3,
  "name": "Opal DevTools",
  "version": "0.1.13",
  "description": "Ruby/Opal REPL for Edge DevTools - Execute Ruby code directly in your browser",
  "devtools_page": "devtools.html",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/opal-16.png",
      "48": "icons/opal-48.png",
      "128": "icons/opal-128.png"
    }
  },
  "icons": {
    "16": "icons/opal-16.png",
    "48": "icons/opal-48.png",
    "128": "icons/opal-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
